fi

# --- Restrict the agent to ONLY the CRUD tool ------------------------------- #
# Install a single-name wrapper so the permission rule matches it exactly (a
# rule on 'python3' would auto-approve any Python). Every other command falls
# outside the allowlist and is not auto-approved. bwrap remains the hard OS
# backstop underneath. Shared across providers — both need the exact-name
# wrapper, whichever way each one is told to trust it.
CRUD_WRAPPER="$HOME/.local/bin/odoo-crud"
mkdir -p "$HOME/.local/bin"
cat > "$CRUD_WRAPPER" <<CRUD
#!/usr/bin/env bash
# Record every real invocation AND its exit code, independently of anything
# the model later claims in its own summary — a failed call (e.g. a rejected
# import-csv) is not proof of a write, so the audit check after the run in
# Step 3 needs the outcome, not just that the command was attempted.
python3 "$CRUD_TOOL" "\$@"
status=\$?
[[ -n "\${ODOO_CRUD_AUDIT_LOG:-}" ]] && printf '%s %s exit=%s\n' "\$(date -u +%FT%TZ)" "\$*" "\$status" >> "\$ODOO_CRUD_AUDIT_LOG" 2>/dev/null
exit "\$status"
CRUD
chmod +x "$CRUD_WRAPPER"

case "$AI_CLI" in
agy)
