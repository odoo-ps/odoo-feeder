# Generate a self-contained launcher inside the scratch dir. It runs agy inside an
# OS-level jail: the whole system is read-only, only the scratch dir + agy's own
# config/cache are writable, sensitive home dirs are masked, network is on, and
# only the ODOO_* credentials are exposed. So the agent's only real capability is
# to run the CRUD tool against the target database.
#
# The jail technology differs per platform:
#   • Linux : bubblewrap (bwrap) namespaces.
#   • macOS : Seatbelt via sandbox-exec + a generated SBPL profile. There is no
#             PID/mount-namespace equivalent, so we translate the bwrap policy to
#             "everything readable, filesystem read-only, writes only to the
#             scratch dir + agy's config/cache/tmp, ~/.ssh unreadable, network on".
#
# The heredoc is quoted ('LAUNCH') so nothing expands now: ODOO_* / AI_BIN /
# AI_MODEL / HOME are read from the environment at run time, keeping secrets out
# of this file on disk.
cat > "$WORK/launch.sh" <<'LAUNCH'
#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# Ground truth for whether the model actually ran odoo-crud at all, checked
# against its claimed SUMMARY after the run — see the CRUD_WRAPPER above and
# the audit check below.
export ODOO_CRUD_AUDIT_LOG="$HERE/.odoo-crud-calls.log"

# Build the actual "$AI_BIN ...args" invocation into the AI_ARGV array. Each
# provider has its own flag shape (agy: positional prompt + --sandbox/
# --print-timeout; copilot: -p/-i + --allow-tool; claude: -p + --allowed-tools/
# --disallowed-tools. Neither copilot nor claude has a native timeout flag, so
# headless mode is wrapped in the `timeout` command instead).
#
# copilot's tool restriction is a per-invocation flag, not a settings file:
# --allow-tool='shell(odoo-crud),...' pre-approves exactly the CRUD wrapper
# (verified empirically: with this flag alone, 'cat /etc/passwd' and 'touch
# <file>' were both attempted by the model and then DENIED by copilot's own
# runtime, while 'odoo-crud ...' actually ran). --available-tools was tried
# too but rejected: it doesn't enforce the "(odoo-crud)" sub-command filter at
# all (a bare '--available-tools=shell(odoo-crud)' let arbitrary shell
# commands through) and in combination confused the model into refusing even
# odoo-crud calls. --allow-all-tools was rejected outright — real command
# execution proved it approves genuinely dangerous commands, not just the
# allowlisted one. --allow-all-urls is still needed (web_fetch/web_search
# require a separate, per-URL permission on top of the tool permission).
#
# Known, accepted residual: copilot has a small built-in bypass for a couple
# of intrinsically harmless commands (e.g. 'echo', 'cd') that always skip
# approval regardless of --allow-tool — GitHub's own docs describe this. bwrap
# / Seatbelt is the actual hard backstop here (read-only filesystem outside
# the scratch dir), exactly as it already is for agy, so this bypass can't do
# anything the sandbox doesn't already allow.
#
# claude's tool restriction is also per-invocation: --allowed-tools scopes the
# exact Bash pattern for the CRUD wrapper plus Read/Write/WebFetch/WebSearch;
# --disallowed-tools 'mcp__*' strips out any MCP servers the user's own global
# ~/.claude config might define, so the allowlist can't be widened by config
# already sitting on the machine. --permission-mode default is passed
# explicitly so a locally saved bypassPermissions/acceptEdits default can't
# silently widen what runs unattended. Same as the other providers, bwrap /
# Seatbelt remains the hard backstop underneath.
build_ai_argv() {
    local mode="${MODE:-batch}" request; request="$(cat "$HERE/request.txt")"
    case "$AI_CLI" in
        agy)
            if [[ "$mode" == "interactive" ]]; then
                AI_ARGV=("$AI_BIN" --sandbox --model "$AI_MODEL" -i "$request")
            else
                AI_ARGV=("$AI_BIN" -p "$request" --model "$AI_MODEL" --print-timeout "$AGY_TIMEOUT")
            fi
            ;;
        copilot)
            local tools='shell(odoo-crud),read,write,web_fetch,web_search'
            if [[ "$mode" == "interactive" ]]; then
                AI_ARGV=("$AI_BIN" --model "$AI_MODEL" --allow-tool="$tools" --allow-all-urls -i "$request")
            else
                AI_ARGV=("$AI_BIN" --model "$AI_MODEL" --allow-tool="$tools" \
                    --allow-all-urls --no-ask-user -s -p "$request")
                command -v timeout >/dev/null 2>&1 && AI_ARGV=(timeout "$AGY_TIMEOUT" "${AI_ARGV[@]}")
            fi
            ;;
        claude)
            local allowed=("Bash(odoo-crud:*)" "Read" "Write" "WebFetch" "WebSearch")
            if [[ "$mode" == "interactive" ]]; then
                AI_ARGV=("$AI_BIN" "$request" --model "$AI_MODEL" --permission-mode default \
                    --allowed-tools "${allowed[@]}" --disallowed-tools "mcp__*")
            else
                AI_ARGV=("$AI_BIN" "$request" -p --model "$AI_MODEL" --permission-mode default \
                    --allowed-tools "${allowed[@]}" --disallowed-tools "mcp__*")
                command -v timeout >/dev/null 2>&1 && AI_ARGV=(timeout "$AGY_TIMEOUT" "${AI_ARGV[@]}")
            fi
            ;;
    esac
}

# --- macOS: Seatbelt (sandbox-exec) --------------------------------------- #
# No bubblewrap on macOS. Build an SBPL profile that mirrors the bwrap policy
# and hand off to sandbox-exec. The AI CLI inherits ODOO_*/AI_*/AGY_* straight
# from this process's environment (no --setenv needed). Paths must be the physical ones
# the kernel sees, so resolve $HERE with `pwd -P` (mktemp lives under a symlink).
if [[ "$(uname -s)" == "Darwin" ]]; then
    HERE_P="$(cd "$HERE" && pwd -P)"
    SB="$HERE/jail.sb"
    cat > "$SB" <<SBPL
(version 1)
(allow default)
(deny file-write*)
(allow file-write*
    (subpath "$HERE_P")
    (subpath "$HOME/.gemini")
    (subpath "$HOME/.copilot")
    (subpath "$HOME/.claude")
    (subpath "$HOME/.cache")
    (subpath "$HOME/.config")
    (subpath "$HOME/Library/Caches")
    (subpath "$HOME/Library/Application Support")
    (subpath "/private/tmp")
    (subpath "/private/var/tmp")
    (subpath "/private/var/folders")
    (literal "/dev/null") (literal "/dev/zero")
    (regex #"^/dev/(tty|fd|stdin|stdout|stderr)"))
(deny file-read* (subpath "$HOME/.ssh"))
SBPL
    build_ai_argv
    exec sandbox-exec -f "$SB" "${AI_ARGV[@]}"
fi

