build_ai_argv
exec bwrap "${bwrap_args[@]}" "${AI_ARGV[@]}"
LAUNCH
chmod +x "$WORK/launch.sh"
export AI_CLI AI_BIN AI_MODEL AGY_TIMEOUT

if [[ "$INTERACTIVE" -eq 1 ]]; then
    # Interactive: the terminal is already a TTY, run the launcher directly.
    MODE=interactive "$WORK/launch.sh"
    exit $?
fi

# Non-interactive (default). agy's headless mode silently drops stdout under a
# non-TTY, so we attach the launcher to a pseudo-TTY, then strip ANSI escapes from
# the captured output. Prefer util-linux `script`; fall back to a tiny Python pty
# wrapper so no extra system package is required (python3 is already a dependency).
pty_run() {
    # util-linux `script` takes `-qec CMD FILE`; BSD/macOS `script` has a totally
    # different signature (no -c). `script --version` succeeds only on util-linux,
    # so use it there and fall back everywhere else (macOS, or no `script`) to a
    # tiny Python pty wrapper — portable and it preserves the child exit code.
    if script --version >/dev/null 2>&1; then
        script -qec "$1" /dev/null
    else
        # Not plain pty.spawn(): on macOS the pty master never signals EOF/error
        # once the child exits (a long-standing CPython bug — spawn()'s select()
        # loop blocks forever even though all output already streamed), so the
        # whole pipeline hangs after the agent finishes instead of returning.
        # Poll the child's exit status directly instead of waiting on EOF, and
        # only stop once a post-exit read comes back empty (fully drained).
        python3 - "$1" <<'PY'
import os, sys, pty, select

def spawn(argv):
    pid, master_fd = pty.fork()
    if pid == 0:
        os.execvp(argv[0], argv)
    exited = False
    status = 0
    while True:
        rfds, _, _ = select.select([master_fd], [], [], 0.25)
        got_data = False
        if master_fd in rfds:
            try:
                data = os.read(master_fd, 4096)
            except OSError:
                data = b""
            if data:
                os.write(1, data)
                got_data = True
        if not exited:
            wpid, status = os.waitpid(pid, os.WNOHANG)
            if wpid == pid:
                exited = True
        if exited and not got_data:
            break
    os.close(master_fd)
    return status

sys.exit(os.waitstatus_to_exitcode(spawn([sys.argv[1]])))
PY
    fi
}

# ANSI-escape stripper, portable across GNU and BSD sed:
#   • `-E` (extended regex) is understood by both (GNU aliases it to -r).
#   • unbuffered/line-buffered output keeps progress live: GNU uses -u, BSD -l.
#   • `\x1B` is a GNU-only escape, so feed sed a literal ESC byte instead.
ESC=$(printf '\033')
if sed --version >/dev/null 2>&1; then SED_STREAM=(-u -E); else SED_STREAM=(-l -E); fi

# The AI CLI can fail (e.g. a quota/auth error from the backend) without ever
# writing a byte to its own stdout/the pty — the failure only lands in its own
# CLI log. Mark the time before the run so we can find that log afterwards and
# surface the real error instead of just "review the output above" when there
# is no output.
AGY_LOG_DIR="$(provider_log_dir)"
AGY_LOG_GLOB="$(provider_log_glob)"
AGY_LOG_ERROR_PATTERN="$(provider_log_error_pattern)"
AGY_LOG_MARK="$WORK/.agy-log-mark"
touch "$AGY_LOG_MARK"

LOG="$WORK/agy-output.log"
# Ground truth for whether the model actually ran odoo-crud, independent of
# whatever it claims in its own SUMMARY (see CRUD_WRAPPER above, Step 2 —
# every real invocation + its exit code is appended there, so a model that
# just narrates fake tool calls and results — a real failure mode, especially
# with weaker/free models via --openrouter-model — leaves this file empty).
AUDIT_LOG="$WORK/.odoo-crud-calls.log"

set +e
pty_run "$WORK/launch.sh" \
    | sed "${SED_STREAM[@]}" "s/${ESC}\[[0-9;]*[A-Za-z]//g" | tr -d '\r' | tee "$LOG"
status=${PIPESTATUS[0]}
set -e

# $WORK is deleted on exit (see the trap above), so persist this run's full
# transcript + odoo-crud audit trail somewhere that survives the process, and
# print it below — no matter how the run turns out — so it's always there to
# inspect instead of only "see the output above" in a scrollback that may
# already be gone.
PERSIST_LOG_DIR="$HOME/.local/share/odoo-demo-feeder/logs"
mkdir -p "$PERSIST_LOG_DIR"
PERSIST_LOG="$PERSIST_LOG_DIR/run-$(date -u +%Y%m%dT%H%M%SZ).log"
{
    cat "$LOG" 2>/dev/null
    echo
    echo "----- odoo-crud calls actually made (audit trail) -----"
    if [[ -s "$AUDIT_LOG" ]]; then
        cat "$AUDIT_LOG"
    else
        echo "(none — odoo-crud was never invoked)"
    fi
} > "$PERSIST_LOG" 2>/dev/null || true
info "Full log: file://$PERSIST_LOG"

show_agy_log_errors() {
    [[ -d "$AGY_LOG_DIR" ]] || return 0
    local f errs
    # Log filenames embed a sortable timestamp, so a plain lexicographic sort
    # picks the most recent one — no need for `stat`, whose flags differ
    # between macOS (BSD) and Linux (GNU).
    f="$(find "$AGY_LOG_DIR" -name "$AGY_LOG_GLOB" -newer "$AGY_LOG_MARK" 2>/dev/null | sort | tail -n1)"
    [[ -n "$f" ]] || return 0
    errs="$(grep -E "$AGY_LOG_ERROR_PATTERN" "$f" 2>/dev/null | tail -n3)"
    [[ -n "$errs" ]] || return 0
    warn "$AI_BIN's own log ($f) reports:"
    printf '%s\n' "$errs" | sed 's/^/    /' >&2
}

# BYOK (e.g. OpenRouter) provider errors are the trickiest to diagnose: the
# HTTP status code Copilot surfaces is often generic/misleading (e.g. it
# reported "403" for what OpenRouter's own JSON body called a 402 insufficient-
# credits error), and the real reason only shows up in the provider's response
# body, not in Copilot's own log. Recognize this class of failure from the
# transcript and point straight at the likely cause + a way to self-check.
diagnose_provider_error() {
    [[ -n "${COPILOT_PROVIDER_BASE_URL:-}" ]] || return 0
    grep -qiE 'authentication failed with provider|HTTP 40[0-9]' "$LOG" 2>/dev/null || return 0
    warn "This looks like a BYOK provider error ($COPILOT_PROVIDER_BASE_URL, model $AI_MODEL)."
    if grep -qiE 'HTTP 402|insufficient credit' "$LOG"; then
        warn "  → Insufficient credits on that provider account. Add credits, or use a
     free-tier model (often suffixed ':free'): https://openrouter.ai/settings/credits"
    elif grep -qiE 'HTTP 401|invalid.*api.?key|unauthorized' "$LOG"; then
        warn "  → The stored key looks invalid or revoked. Re-store it:
     keyring set $OPENROUTER_KEYRING_SERVICE $OPENROUTER_KEYRING_ACCOUNT"
    else
        warn "  → The reported HTTP code alone can be misleading (a real case here was
     a 403 that was actually a 402 insufficient-credits error underneath).
     Check the key directly against the provider to see its real error body:
       curl -s ${COPILOT_PROVIDER_BASE_URL%/}/chat/completions \\
         -H \"Authorization: Bearer \$(keyring get $OPENROUTER_KEYRING_SERVICE $OPENROUTER_KEYRING_ACCOUNT)\" \\
         -H 'Content-Type: application/json' \\
         -d '{\"model\":\"$AI_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}'"
    fi
}

# See AUDIT_LOG's definition above (right after LOG).
check_real_writes_happened() {
    if [[ ! -s "$AUDIT_LOG" ]]; then
        warn "odoo-crud was never actually invoked during this run."
        warn "  → The model narrated tool calls and a summary without ever running them —"
        warn "    nothing was written to the database. This is a known failure mode with"
        warn "    models that don't reliably support real tool/function calling; if you're"
        warn "    using --openrouter-model, try a different (typically larger) model."
        return 1
    fi
    if ! grep -qE '\b(create|write|unlink|import-csv|set-image|call)\b.*exit=0$' "$AUDIT_LOG"; then
        warn "odoo-crud never completed a write during this run (see $AUDIT_LOG)."
        warn "  → Either no create/write/unlink/import-csv/set-image/call was ever made, or"
        warn "    every one of them failed (nonzero exit) — the database was not actually"
        warn "    modified despite the summary below. Check the log above for the real error"
        warn "    each failed call returned, then retry."
        return 1
    fi
    return 0
}

echo
# Match loosely (case-insensitive, no line-start anchor): providers sometimes
# wrap the requested plain-text line in markdown decoration (e.g. '**SUMMARY:**'
# or a leading bullet) despite being told not to.
if grep -qi 'SUMMARY:' "$LOG" 2>/dev/null && check_real_writes_happened; then
    printf '%s\n' "${GREEN}✔ Done!${RESET}"
    grep -i 'SUMMARY:' "$LOG" | sed "s/^/  ${GREEN}/; s/\$/${RESET}/"
elif grep -qi 'SUMMARY:' "$LOG" 2>/dev/null; then
    printf '%s\n' "${DIM}Reported summary (not trusted — see warning above):${RESET}"
    grep -i 'SUMMARY:' "$LOG" | sed "s/^/  ${DIM}/; s/\$/${RESET}/"
    die "The run reported success but never actually wrote to the database."
elif [[ "$status" -ne 0 ]]; then
    diagnose_provider_error
    show_agy_log_errors
    die "The AI agent exited with an error (code $status). See the output above."
else
    show_agy_log_errors
    warn "The agent finished but produced no SUMMARY line — please review the output above."
fi
