[[ -n "${COPILOT_PROVIDER_BASE_URL:-}" ]] && bwrap_args+=(--setenv COPILOT_PROVIDER_BASE_URL "$COPILOT_PROVIDER_BASE_URL")
[[ -n "${COPILOT_PROVIDER_TYPE:-}" ]] && bwrap_args+=(--setenv COPILOT_PROVIDER_TYPE "$COPILOT_PROVIDER_TYPE")
