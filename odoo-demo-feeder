    # already there). Strict, non-regex matching (agy default) —
    # 'command(odoo-crud)' matches any 'odoo-crud <subcommand>' invocation.
    AI_SETTINGS="$(provider_settings_path)"
    mkdir -p "$(dirname "$AI_SETTINGS")"
    ALLOW_RULES=()
    while IFS= read -r rule; do ALLOW_RULES+=("$rule"); done < <(provider_permission_allow_rules)
    if python3 - "$AI_SETTINGS" "${ALLOW_RULES[@]}" <<'PY'
import json, sys
path = sys.argv[1]
rules = sys.argv[2:]
try:
    with open(path) as f:
        data = json.load(f)
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}
allow = data.setdefault("permissions", {}).setdefault("allow", [])
for rule in rules:
    if rule not in allow:
        allow.append(rule)
with open(path, "w") as f:
    json.dump(data, f, indent=2)
PY
    then
        info "  ✔ Agent restricted to the 'odoo-crud' tool"
    else
        warn "Could not write $AI_BIN permissions; the run may prompt for approvals."
    fi
    ;;
copilot|claude)
    # Neither takes a persistent allowlist file — tool restriction is applied
    # per-invocation (--allow-tool for copilot, --allowed-tools/--disallowed-tools
    # for claude) in the launcher below.
    info "  ✔ Agent will be restricted to the 'odoo-crud' tool at launch"
    ;;
esac
echo

