#!/usr/bin/env bash
#
# Odoo Demo Database Feeder
# -------------------------
# A friendly launcher that lets a (non-technical) sales person populate an Odoo
# demo database with realistic data for a given industry / scope, driven by the
# Antigravity AI agent (agy).
#
# By default the agent runs NON-INTERACTIVELY and inside an OS-level sandbox
# (bubblewrap on Linux, Seatbelt/sandbox-exec on macOS) so its only real
# capability is to call the CRUD tool against the target database. Pass
# -i / --interactive to drive agy interactively instead.
#
set -euo pipefail

# --------------------------------------------------------------------------- #
# Configuration
# --------------------------------------------------------------------------- #
# Public GitHub repo (owner/repo) holding the demo skills, pulled via `npx skills`.
# Set it empty (SKILLS_REPO= odoo-demo-feeder) to skip the remote refresh and run
# whatever is already in ~/.agents/skills — the way to try a skill edit unpushed.
SKILLS_REPO="${SKILLS_REPO-odoo-ps/odoo-feeder}"

# The one-line bootstrap that installs every dependency and fetches this tool.
# Standalone-run error messages point here (there is no separate install.sh).
BOOTSTRAP="bash <(curl -fsSL https://raw.githubusercontent.com/odoo-ps/odoo-feeder/main/feed.sh)"

CRUD_TOOL="${CRUD_TOOL:-$HOME/.local/share/odoo-demo-feeder/odoo_crud.py}"
# Which AI CLI drives the agent: "agy" (Antigravity, default), "copilot"
# (GitHub Copilot CLI) or "claude" (Claude Code).
AI_CLI="${AI_CLI:-agy}"
AGY_TIMEOUT="${AGY_TIMEOUT:-20m}"   # headless print-mode budget (research+install+imports)
# OpenRouter BYOK, 'copilot' provider only: set to an OpenRouter model id (e.g.
# anthropic/claude-sonnet-4.5) to route Copilot through OpenRouter instead of
# GitHub's own model routing. The API key is never accepted as a flag or
# plaintext env var — store it once in the OS keyring first:
#   keyring set odoo-feeder openrouter-api-key
OPENROUTER_MODEL="${OPENROUTER_MODEL:-}"
OPENROUTER_KEYRING_SERVICE="odoo-feeder"
OPENROUTER_KEYRING_ACCOUNT="openrouter-api-key"

INTERACTIVE=0
PLAN=0
GAVE_ARGS=0

# Values may come from flags (below) or from environment variables of the same
# name. Anything still empty after parsing is asked for interactively.
ODOO_URL="${ODOO_URL:-}"
ODOO_LOGIN="${ODOO_LOGIN:-}"
ODOO_SECRET="${ODOO_SECRET:-}"
ODOO_DB="${ODOO_DB:-}"
ODOO_SCOPE="${ODOO_SCOPE:-}"
COMPANY_NAME="${COMPANY_NAME:-}"
COMPANY_SITE="${COMPANY_SITE:-}"
EXTRA="${EXTRA:-}"
ODOO_SIZE="${ODOO_SIZE:-}"   # small | medium | big (dataset volume)

# A sales "template": a free-text block (pasted or loaded from --template FILE)
# describing the demo to build. It is passed to the AI verbatim — never parsed —
# so any key the sales person writes is understood by the agent.
TEMPLATE_FILE="${TEMPLATE_FILE:-}"   # path to a template file (non-interactive load)
TEMPLATE_TEXT="${TEMPLATE_TEXT:-}"   # raw template contents

# --------------------------------------------------------------------------- #
# Colors (Odoo brand) — degrade gracefully when no TTY / NO_COLOR
# --------------------------------------------------------------------------- #
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    PURPLE=$'\e[38;5;97m'   # ~ Odoo #714B67
    TEAL=$'\e[38;5;37m'
    BOLD=$'\e[1m'
    DIM=$'\e[2m'
    RED=$'\e[31m'
    GREEN=$'\e[32m'
    RESET=$'\e[0m'
else
    PURPLE=""; TEAL=""; BOLD=""; DIM=""; RED=""; GREEN=""; RESET=""
fi

info()  { printf '%s\n' "${TEAL}$*${RESET}"; }
warn()  { printf '%s\n' "${RED}! $*${RESET}" >&2; }
die()   { printf '%s\n' "${RED}✖ $*${RESET}" >&2; exit 1; }

# --------------------------------------------------------------------------- #
# UI helpers — use `gum` for a nicer interface when it is available and we have a
# TTY, and degrade to plain `read` prompts otherwise. Every helper prints its
# result on stdout (so it can be captured with $(...)) and its UI on stderr, so
# the two never mix in the captured value.
# --------------------------------------------------------------------------- #
HAS_GUM=0
if command -v gum >/dev/null 2>&1 && [[ -t 0 && -t 2 ]]; then HAS_GUM=1; fi
export GUM_INPUT_PROMPT_FOREGROUND="#714B67"   # Odoo purple accent

ui_input() {  # ui_input <label> [placeholder]
    if [[ "$HAS_GUM" -eq 1 ]]; then
        gum input --prompt "$1 " --placeholder "${2:-}"
    else
        local v; read -r -p "  $1${2:+ ($2)}: " v; printf '%s' "$v"
    fi
}
ui_input_value() {  # ui_input_value <label> [value]
    if [[ "$HAS_GUM" -eq 1 ]]; then
        gum input --prompt "$1 " --value "${2:-}"
    else
        local v; read -r -p "  $1${2:+ ($2)}: " v; printf '%s' "${v:-$2}"
    fi
}
ui_password() {  # ui_password <label>
    if [[ "$HAS_GUM" -eq 1 ]]; then
        gum input --password --prompt "$1 "
    else
        local v; read -r -s -p "  $1 " v; printf '\n' >&2; printf '%s' "$v"
    fi
}
ui_choose() {  # ui_choose <header> <option>...  -> prints the chosen option
    local header="$1"; shift
    if [[ "$HAS_GUM" -eq 1 ]]; then
        gum choose --header "$header" "$@"
    else
        local opt i=1
        printf '  %s\n' "$header" >&2
        for opt in "$@"; do printf '    %d) %s\n' "$i" "$opt" >&2; i=$((i+1)); done
        local n; read -r -p "  Choice [1]: " n; n="${n:-1}"
        if [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=$# )); then
            printf '%s' "${!n}"
        else
            printf '%s' "$1"
        fi
    fi
}
ui_write() {  # ui_write [placeholder]  -> prints the pasted multi-line text
    if [[ "$HAS_GUM" -eq 1 ]]; then
        # In gum ≥0.16, Enter submits and Ctrl+J inserts a newline; a pasted block
        # keeps its own newlines, so paste then press Enter.
        gum write --placeholder "${1:-Paste here…}" --width 0 --height 18 \
                  --header "Paste, then Enter to submit (Ctrl+J for a new line)"
    else
        printf '  %s\n' "${1:-Paste your text, then press Ctrl+D when done:}" >&2
        cat
    fi
}
ui_header() {  # ui_header <text>
    if [[ "$HAS_GUM" -eq 1 ]]; then
        gum style --foreground "#714B67" --bold "$*"
    else
        info "$*"
    fi
}

# Validate an Odoo URL: must be http(s), and never the public odoo.com site.
# Returns non-zero (and warns) when the URL is not acceptable.
check_url() {
    local url="$1" host
    if [[ ! "$url" =~ ^https?:// ]]; then
        warn "The URL must start with http:// or https://"
        return 1
    fi
    host="${url#*://}"; host="${host%%/*}"; host="${host%%:*}"
    host="$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')"
    if [[ "$host" == "odoo.com" || "$host" == "www.odoo.com" ]]; then
        warn "For safety, the public odoo.com production site is blocked."
        warn "Use a customer database (e.g. *.odoo.com) or a dedicated server."
        return 1
    fi
    return 0
}

print_logo() {
    printf '\n%s' "$PURPLE$BOLD"
    cat <<'LOGO'
   ██████      ██  ██████   ██████
  ██    ██     ██ ██    ██ ██    ██
  ██    ██ ██████ ██    ██ ██    ██
  ██    ██ ██  ██ ██    ██ ██    ██
   ██████  ██████  ██████   ██████
LOGO
    printf '%s\n' "$RESET"
    printf '%s\n' "${PURPLE}${BOLD}   Demo Database Feeder${RESET}"
    printf '%s\n\n' "${DIM}   Populate a demo database with realistic data, powered by AI.${RESET}"
}

usage() {
    cat <<USAGE
Usage: odoo-demo-feeder [options]

Any value not passed as a flag (or set as an environment variable) is asked for
interactively. Passing at least one value flag runs non-interactively (optional
fields are simply skipped when omitted).

Connection:
  --url URL             Odoo URL (blocked: odoo.com / www.odoo.com)
  --login USER          Login (email or user)          [ODOO_LOGIN]
  --secret SECRET       API key or password            [ODOO_SECRET]
  --db NAME             Database name (needed for localhost / self-hosted) [ODOO_DB]

Content:
  --scope TEXT          Industry / scope, e.g. "Bakery"  [ODOO_SCOPE]
  --size SIZE           Dataset volume: small | medium | big (default medium) [ODOO_SIZE]
  --company NAME        Customer company to research     [COMPANY_NAME]
  --website URL         Customer website to research     [COMPANY_SITE]
  --notes TEXT          Extra free-text instructions for the AI  [EXTRA]
                        e.g. "also create 5 sales orders and a few invoices"
  --template FILE       Load a template file describing the demo to build and
                        pass it to the AI verbatim (see the template block below).
                        Interactively, you can paste a template instead.

A template is a free-text block the AI reads directly — write any keys you like:
  name: Maison Rorive demo
  website: https://www.maisonrorive.be
  company_name: Maison Rorive
  country: BE
  apps: [sale_management, crm, website, helpdesk]
  data_size: big
  override_model_size: {product.product: 100, crm.lead: 30}
  configuration: enable pricelists, multi-currency, default sales team "Retail"

Other:
  -i, --interactive     Drive the AI agent interactively — launches its TUI
                        instead of running headless (advanced).
      --plan            Review a plan and approve it before any change is made
                        (implies interactive).
      --ai-cli NAME     AI CLI to drive the agent: 'agy' (Antigravity, default),
                        'copilot' (GitHub Copilot CLI) or 'claude' (Claude Code). [AI_CLI]
      --openrouter-model ID   Route 'copilot' through OpenRouter using this model
                        id (e.g. anthropic/claude-sonnet-4.5), instead of
                        GitHub's own model routing. [OPENROUTER_MODEL]
                        The API key is read from the OS keyring, never from a
                        flag or plaintext env var — store it once with:
                          keyring set odoo-feeder openrouter-api-key
  -h, --help            Show this help.

Example:
  odoo-demo-feeder --url http://localhost:8069 --login admin --secret admin \\
    --db mydb --scope "Bakery" --company "Maison Rorive" \\
    --website https://www.maisonrorive.be
USAGE
}

# --------------------------------------------------------------------------- #
# Argument parsing
# --------------------------------------------------------------------------- #
need_val() { [[ -n "${2:-}" ]] || die "Option $1 needs a value."; }
while [[ $# -gt 0 ]]; do
    case "$1" in
        --url)                 need_val "$1" "${2:-}"; ODOO_URL="$2";     GAVE_ARGS=1; shift 2 ;;
        --login|--user)        need_val "$1" "${2:-}"; ODOO_LOGIN="$2";   GAVE_ARGS=1; shift 2 ;;
        --secret|--key|--password) need_val "$1" "${2:-}"; ODOO_SECRET="$2"; GAVE_ARGS=1; shift 2 ;;
        --db|--database)       need_val "$1" "${2:-}"; ODOO_DB="$2";      GAVE_ARGS=1; shift 2 ;;
        --scope)               need_val "$1" "${2:-}"; ODOO_SCOPE="$2";   GAVE_ARGS=1; shift 2 ;;
        --size)                need_val "$1" "${2:-}"; ODOO_SIZE="$2";    GAVE_ARGS=1; shift 2 ;;
        --company)             need_val "$1" "${2:-}"; COMPANY_NAME="$2"; GAVE_ARGS=1; shift 2 ;;
        --website)             need_val "$1" "${2:-}"; COMPANY_SITE="$2"; GAVE_ARGS=1; shift 2 ;;
        --notes|--extra)       need_val "$1" "${2:-}"; EXTRA="$2";        GAVE_ARGS=1; shift 2 ;;
        --template)            need_val "$1" "${2:-}"; TEMPLATE_FILE="$2"; GAVE_ARGS=1; shift 2 ;;
        --ai-cli)              need_val "$1" "${2:-}"; AI_CLI="$2";        shift 2 ;;
        --openrouter-model)    need_val "$1" "${2:-}"; OPENROUTER_MODEL="$2"; shift 2 ;;
        -i|--interactive)      INTERACTIVE=1; shift ;;
        --plan)                PLAN=1; INTERACTIVE=1; shift ;;
        -h|--help)             usage; exit 0 ;;
        *) usage; die "Unknown option: $1" ;;
    esac
done

# --------------------------------------------------------------------------- #
# AI CLI provider dispatch — agy (Antigravity), copilot (GitHub Copilot CLI)
# and claude (Claude Code) are implemented; every function below is the seam a
# future provider plugs into. Unknown providers fail fast, before any sandbox
# work.
# --------------------------------------------------------------------------- #
provider_supported() {
    case "$AI_CLI" in
        agy|copilot|claude) ;;
        *)      die "Unknown --ai-cli '$AI_CLI'. Only 'agy', 'copilot' and 'claude' are supported today." ;;
    esac
}
provider_supported
provider_bin() {
    case "$AI_CLI" in
        agy)     printf 'agy' ;;
        copilot) printf 'copilot' ;;
        claude)  printf 'claude' ;;
    esac
}
provider_default_model() {
    case "$AI_CLI" in
        agy)
            # agy's model ids change from release to release (renames, retired
            # tiers), and an unknown id makes it abort immediately ("model ...
            # is not recognized"), so never hardcode one: ask the installed
            # build what it actually offers and prefer from there.
            # Output varies by build: a bare id per line, or 'id<TAB>Display
            # Name' behind a 'Fetching available models...' status line — take
            # the first field and keep only lines that look like an id.
            local models pref
            models="$(agy models 2>/dev/null | awk '{print $1}' | grep -E '^[a-z0-9.-]+$')"
            for pref in gemini-3.1-pro-high gemini-3.1-pro-low gemini-3.6-flash-high gemini-3.5-flash-high; do
                if grep -qxF -- "$pref" <<<"$models"; then printf '%s' "$pref"; return; fi
            done
            printf '%s' "$(head -n1 <<<"$models")"   # none of the preferences exist
            ;;
        copilot) printf 'auto' ;;   # let Copilot pick a model automatically
        claude)  printf 'sonnet' ;;
    esac
}
# Only agy persists its allowlist to a settings file; copilot's and claude's
# permissions are per-invocation flags (see the launcher below), so this is
# agy-only.
provider_settings_path() { printf '%s/.gemini/antigravity-cli/settings.json' "$HOME"; }
provider_log_dir() {
    case "$AI_CLI" in
        agy)     printf '%s/.gemini/antigravity-cli/log' "$HOME" ;;
        copilot) printf '%s/.copilot/logs' "$HOME" ;;
        claude)  printf '' ;;   # claude surfaces its own errors on stdout/stderr, no separate log to mine
    esac
}
provider_log_glob() {
    case "$AI_CLI" in
        agy)     printf 'cli-*.log' ;;
        copilot) printf 'process-*.log' ;;
        claude)  printf '' ;;
    esac
}
provider_log_error_pattern() {
    case "$AI_CLI" in
        agy)     printf '^E[0-9]{4}' ;;
        copilot) printf '\[ERROR\]' ;;
        claude)  printf '' ;;
    esac
}
# Permission rules the agy agent needs: the CRUD wrapper, plus web/file access
# for the skill (see the settings-merge block in Step 2 below). agy-only.
#
# 'command(odoo-crud)' only allows the name; agy's --sandbox mode separately
# gates any command that needs network/full-disk access (odoo-crud does, for
# its XML-RPC calls) behind its own "Allow sandbox bypass?" prompt — a prompt
# headless mode can't answer, and even in --interactive mode it just adds a
# per-call confirmation the agent has to get through every time. Persisting
# 'unsandboxed(odoo-crud)' — the exact rule agy itself writes here when a human
# picks "always allow ... (Persist to settings.json)" — grants that bypass
# upfront instead of prompting for it.
provider_permission_allow_rules() { printf '%s\n' "command(odoo-crud)" "unsandboxed(odoo-crud)" "read_url(*)" "read_file(*)" "write_file(*)"; }

AGY_MODEL="${AGY_MODEL:-$(provider_default_model)}"   # kept for backwards compatibility
AI_MODEL="${AI_MODEL:-$AGY_MODEL}"

# --------------------------------------------------------------------------- #
# OpenRouter BYOK (copilot only) — see `copilot help providers`. GitHub
# Copilot CLI activates "bring your own key" mode purely via env vars, so this
# just resolves the API key from the OS keyring and exports the right ones;
# no GitHub sign-in is needed once this is active.
# --------------------------------------------------------------------------- #
if [[ -n "$OPENROUTER_MODEL" ]]; then
    [[ "$AI_CLI" == "copilot" ]] \
        || die "--openrouter-model / OPENROUTER_MODEL only applies to --ai-cli copilot."
    command -v keyring >/dev/null 2>&1 \
        || die "The 'keyring' CLI is required to read the OpenRouter API key (pip install keyring), then:
   keyring set $OPENROUTER_KEYRING_SERVICE $OPENROUTER_KEYRING_ACCOUNT"
    OPENROUTER_API_KEY="$(keyring get "$OPENROUTER_KEYRING_SERVICE" "$OPENROUTER_KEYRING_ACCOUNT" 2>/dev/null)" \
        || die "No OpenRouter API key found in the OS keyring. Store it once with:
   keyring set $OPENROUTER_KEYRING_SERVICE $OPENROUTER_KEYRING_ACCOUNT"
    [[ -n "$OPENROUTER_API_KEY" ]] || die "The OpenRouter API key stored in the keyring is empty."
    export COPILOT_PROVIDER_BASE_URL="https://openrouter.ai/api/v1"
    export COPILOT_PROVIDER_TYPE="openai"
    export COPILOT_PROVIDER_API_KEY="$OPENROUTER_API_KEY"
    export COPILOT_MODEL="$OPENROUTER_MODEL"
    AI_MODEL="$OPENROUTER_MODEL"   # keep the explicit --model flag in sync with BYOK
fi

# --------------------------------------------------------------------------- #
# Pre-flight checks
# --------------------------------------------------------------------------- #
AI_BIN="$(provider_bin)"
command -v "$AI_BIN" >/dev/null 2>&1 || die "$AI_BIN is not installed.
   Run the one-line bootstrap first: $BOOTSTRAP"
# OS-level sandbox: bubblewrap on Linux, Seatbelt (sandbox-exec) on macOS.
if [[ "$(uname -s)" == "Darwin" ]]; then
    command -v sandbox-exec >/dev/null 2>&1 || die "sandbox-exec (macOS Seatbelt) not found — cannot sandbox the agent."
else
    command -v bwrap >/dev/null 2>&1 || die "bubblewrap (bwrap) is not installed.
   Run the one-line bootstrap first: $BOOTSTRAP"
fi
command -v python3 >/dev/null 2>&1 || die "python3 is not installed.
   Run the one-line bootstrap first: $BOOTSTRAP"
[[ -f "$CRUD_TOOL" ]] || die "CRUD tool not found at $CRUD_TOOL.
   Run the one-line bootstrap first: $BOOTSTRAP"

# The AI CLI must already be signed in: its OAuth flow (browser + paste a code)
# cannot run headless inside the sandbox, so an unauthenticated run would just
# hang until the timeout. Fail fast with clear instructions instead.
#
# Neither agy (OS keyring) nor copilot reliably expose sign-in via a file to
# stat (agy's oauth_creds.json check gave false negatives on a fresh machine),
# so both are probed with a real bounded headless call. claude has an actual
# documented status command (`claude auth status`, exit 0 = signed in), so use
# that directly. Skip the probe with ASSUME_SIGNED_IN=1 (set automatically when
# launched via feed.sh, which already checked) or a provider token
# (ANTIGRAVITY_TOKEN / COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN /
# ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN) for unattended runs.
provider_signed_in() {
    [[ -n "${ASSUME_SIGNED_IN:-}" ]] && return 0
    case "$AI_CLI" in
        agy)
            [[ -n "${ANTIGRAVITY_TOKEN:-}" ]] && return 0
            # Output varies by build: a bare id per line, or 'id<TAB>Display
            # Name' behind a 'Fetching available models...' status line — take
            # the first field and keep only lines that look like an id, or the
            # status line itself gets used as a "model" and the ping below
            # fails on a bogus name, misreporting a signed-in session as not.
            local m; m="$("$AI_BIN" models 2>/dev/null | awk '{print $1}' | grep -E '^[a-z0-9.-]+$' | head -n1)"
            [[ -n "$m" ]] || return 1
            if command -v timeout >/dev/null 2>&1; then
                timeout 30 "$AI_BIN" -p ping --model "$m" --print-timeout 25s >/dev/null 2>&1
            else
                "$AI_BIN" -p ping --model "$m" --print-timeout 25s >/dev/null 2>&1
            fi
            ;;
        copilot)
            [[ -n "${COPILOT_PROVIDER_BASE_URL:-}" ]] && return 0   # BYOK (e.g. OpenRouter) — no GitHub auth needed
            [[ -n "${COPILOT_GITHUB_TOKEN:-}" || -n "${GH_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]] && return 0
            if command -v timeout >/dev/null 2>&1; then
                timeout 30 "$AI_BIN" -p ping --allow-all-tools -s --model "$(provider_default_model)" >/dev/null 2>&1
            else
                "$AI_BIN" -p ping --allow-all-tools -s --model "$(provider_default_model)" >/dev/null 2>&1
            fi
            ;;
        claude)
            [[ -n "${ANTHROPIC_API_KEY:-}" || -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] && return 0
            "$AI_BIN" auth status >/dev/null 2>&1
            ;;
    esac
}
if ! provider_signed_in; then
    local token_hint
    case "$AI_CLI" in
        agy)
            SIGN_IN_HINT="Run '$AI_BIN' once and sign in with your Google account"
            token_hint="ANTIGRAVITY_TOKEN"
            ;;
        copilot)
            SIGN_IN_HINT="Run '$AI_BIN login' to sign in"
            token_hint="COPILOT_GITHUB_TOKEN (or GH_TOKEN/GITHUB_TOKEN)"
            ;;
        claude)
            SIGN_IN_HINT="Run '$AI_BIN auth login' to sign in"
            token_hint="ANTHROPIC_API_KEY (or CLAUDE_CODE_OAUTH_TOKEN)"
            ;;
    esac
    die "$AI_BIN does not seem to be signed in.
   $SIGN_IN_HINT, then re-run.
   (For unattended / CI use, set $token_hint; to skip this check, set
   ASSUME_SIGNED_IN=1.)"
fi

print_logo

# --------------------------------------------------------------------------- #
# Step 1 — collect connection details
# --------------------------------------------------------------------------- #
ui_header "Step 1/3 — Tell me about the database you want to fill."
echo

# URL — prompt (with a retry loop) only if not supplied; always validate.
if [[ -z "$ODOO_URL" ]]; then
    while :; do
        ODOO_URL="$(ui_input "Odoo URL" "e.g. https://mycompany.odoo.com")"
        ODOO_URL="${ODOO_URL%/}"
        check_url "$ODOO_URL" && break
        ODOO_URL=""
    done
else
    ODOO_URL="${ODOO_URL%/}"
    check_url "$ODOO_URL" || die "Refusing to use this URL."
fi

[[ -n "$ODOO_LOGIN" ]]  || ODOO_LOGIN="$(ui_input "Login (email or user)")"
[[ -n "$ODOO_LOGIN" ]]  || die "A login is required."

[[ -n "$ODOO_SECRET" ]] || ODOO_SECRET="$(ui_password "API key or password")"
[[ -n "$ODOO_SECRET" ]] || die "An API key or password is required."

# Verify credentials and database name, and ask again if it fails.
while :; do
    info "  Verifying connection to Odoo..."
    set +e
    AUTH_OUT=$(ODOO_URL="$ODOO_URL" ODOO_LOGIN="$ODOO_LOGIN" ODOO_SECRET="$ODOO_SECRET" ODOO_DB="$ODOO_DB" python3 "$CRUD_TOOL" auth-check 2>&1)
    AUTH_STATUS=$?
    set -e

    if [[ $AUTH_STATUS -eq 0 ]]; then
        # Parse returned database name from JSON if we auto-detected it
        DETECTED_DB=$(printf '%s' "$AUTH_OUT" | python3 -c "import sys, json; print(json.load(sys.stdin).get('result', {}).get('database', ''))" 2>/dev/null || true)
        if [[ -n "$DETECTED_DB" && -z "$ODOO_DB" ]]; then
            ODOO_DB="$DETECTED_DB"
        fi
        info "  ✔ Connection successful (Odoo version $(printf '%s' "$AUTH_OUT" | python3 -c "import sys, json; print(json.load(sys.stdin).get('result', {}).get('version', {}).get('server_version', 'unknown'))" 2>/dev/null || true), Database: $ODOO_DB)"
        break
    else
        err_msg=$(printf '%s' "$AUTH_OUT" | python3 -c "import sys, json; print(json.load(sys.stdin).get('error', ''))" 2>/dev/null || true)
        [[ -n "$err_msg" ]] || err_msg="$AUTH_OUT"
        warn "Connection failed: $err_msg"
        
        # If we cannot read input (non-interactive or not a TTY), die immediately
        if [[ ! -t 0 ]]; then
            die "Connection check failed and cannot prompt in non-interactive terminal."
        fi
        
        echo
        info "Please re-enter your credentials."
        new_url=""
        while :; do
            new_url="$(ui_input_value "Odoo URL" "$ODOO_URL")"
            new_url="${new_url%/}"
            if [[ -z "$new_url" ]]; then
                break
            fi
            if check_url "$new_url"; then
                ODOO_URL="$new_url"
                break
            fi
        done
        local prev_login="$ODOO_LOGIN"
        ODOO_LOGIN=""
        ODOO_SECRET=""
        while [[ -z "$ODOO_LOGIN" ]]; do
